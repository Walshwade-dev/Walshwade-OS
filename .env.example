ENV=development
DEBUG=True
API_KEY=replace-with-a-long-random-value
CORS_ORIGINS=["http://localhost:3000"]
POSTGRES_USER=user
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_SERVER=localhost
POSTGRES_PORT=5433
POSTGRES_DB=wade_os
